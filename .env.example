# Copy to .env for local development. In production these are set in the
# Vercel dashboard (Project → Settings → Environment Variables).

# --- Database (Neon Postgres) -------------------------------------------------
# Neon dashboard → Connection string → "Pooled connection".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sessions -----------------------------------------------------------------
# Any long random string. Generate with: openssl rand -hex 32
# Changing this logs every admin out.
SESSION_SECRET=

# --- Admin sign-in (Google OAuth) ---------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be:
#   https://www.onewonderlake.com/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google accounts allowed into /admin.
# This list alone controls admin access — no database edit required.
ADMIN_EMAILS=contact@onewonderlake.com

# --- Email (Resend) -----------------------------------------------------------
# Sends from contact@onewonderlake.com and receives inbound mail via webhook.
RESEND_API_KEY=
# Resend → Webhooks → signing secret (starts with whsec_). Optional but
# strongly recommended: without it the webhook accepts unverified requests.
RESEND_WEBHOOK_SECRET=
