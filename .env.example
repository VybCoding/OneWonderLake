# Copy to .env for local development. In production these are set in the
# Vercel dashboard (Project → Settings → Environment Variables).

# --- Database (Postgres) ------------------------------------------------------
# Provisioned from the Vercel dashboard: Storage → Marketplace → Neon.
# Vercel injects this automatically in production; you only set it locally.
# Use the POOLED connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sessions -----------------------------------------------------------------
# Any long random string. Generate with: openssl rand -hex 32
# Changing this logs every admin out.
SESSION_SECRET=

# --- Admin sign-in (Google OAuth) ---------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be:
#   https://www.onewonderlake.com/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google accounts allowed into /admin.
# This list alone controls admin access — no database edit required.
# Removing an address revokes access on that person's next request.
ADMIN_EMAILS=contact@onewonderlake.com

# Note: the site sends no email. contact@onewonderlake.com is a Google
# Workspace mailbox, reached through a plain mailto: link on the site.
